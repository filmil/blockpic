load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "yosys",
    srcs = [
        "import.go",
        "yosys.go",
    ],
    importpath = "github.com/filmil/blockpic/pkg/yosys",
    visibility = ["//visibility:public"],
    deps = ["//pkg/ast"],
)

go_test(
    name = "yosys_test",
    srcs = [
        "import_test.go",
        "yosys_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":yosys"],
    deps = [
        "//pkg/ast",
        "//pkg/format",
        "//pkg/parser",
        "//pkg/scanner",
        "//pkg/validation",
    ],
)
