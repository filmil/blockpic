load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "blockpic_lib",
    srcs = [
        "import.go",
        "layout.go",
        "main.go",
        "refine.go",
    ],
    importpath = "github.com/filmil/blockpic/cmd/blockpic",
    visibility = ["//visibility:private"],
    deps = [
        "//pkg/arrange",
        "//pkg/ast",
        "//pkg/format",
        "//pkg/parser",
        "//pkg/refine",
        "//pkg/scanner",
        "//pkg/validation",
        "//pkg/yosys",
    ],
)

go_binary(
    name = "blockpic",
    embed = [":blockpic_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "blockpic_test",
    srcs = ["main_test.go"],
    embed = [":blockpic_lib"],
)
