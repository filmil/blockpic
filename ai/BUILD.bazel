load(
    "@bazel_ebook//build:rules.bzl",
    "ebook_pdf",
    "markdown_lib",
    "pandoc_chunked_html",
)

package(default_visibility = ["//visibility:public"])

markdown_lib(
    name = "md",
    srcs = [
        "spec.md",
    ],
    additional_inputs = ["head.html"],
)

ebook_pdf(
    name = "book_pdf",
    metadata_xml = "epub-metadata.xml",
    title_yaml = "title.yaml",
    deps = [":md"],
)

pandoc_chunked_html(
    name = "html_chunked",
    args = ["--include-in-header=ai/head.html"],
    toc = True,
    deps = [":md"],
)
