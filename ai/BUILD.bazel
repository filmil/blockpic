load(
    "@bazel_ebook//build:rules.bzl",
    "ebook_pdf",
    "markdown_lib",
    "pandoc_chunked_html",
)
load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("//ai:diagram.bzl", "render_diagram")

package(default_visibility = ["//visibility:public"])

exports_files([
    "head.html",
    "shapes.svg",
    "pins_buses.svg",
    "dynamic_sizing.svg",
    "msi_blocks.svg",
    "pin_aware.svg",
    "complex_layout.svg",
    "text_rendering.svg",
    "arrow_rendering.svg",
    "skin_arithmetic.svg",
    "skin_bitwise.svg",
    "skin_latches.svg",
    "skin_muxes.svg",
    "skin_special.svg",
    "skin_utility.svg",
    "skin_with_arrows.svg",
    "test_features.svg",
    "state_machine_feedback.svg",
    "figure_1_1.svg",
])

markdown_lib(
    name = "md",
    srcs = [
        "datasheet.md",
        "spec.md",
    ] + glob(["tasks/*.md"]),
    additional_inputs = [
        "//ai:head.html",
        "shapes.svg",
        "pins_buses.svg",
        "dynamic_sizing.svg",
        "msi_blocks.svg",
        "pin_aware.svg",
        "complex_layout.svg",
        "text_rendering.svg",
        "arrow_rendering.svg",
        "skin_arithmetic.svg",
        "skin_bitwise.svg",
        "skin_latches.svg",
        "skin_muxes.svg",
        "skin_special.svg",
        "skin_utility.svg",
        "test_features.svg",
        "state_machine_feedback.svg",
        "figure_1_1.svg",
    ],
)

ebook_pdf(
    name = "book_pdf",
    metadata_xml = "epub-metadata.xml",
    title_yaml = "title.yaml",
    deps = [":md"],
)

pandoc_chunked_html(
    name = "html_chunked",
    args = ["--include-in-header=ai/head.html"],
    toc = True,
    deps = [":md"],
)

render_diagram(
    name = "shapes",
    src = "examples/shapes.hodos",
)

render_diagram(
    name = "pins_buses",
