load("@bazel_ebook//build:rules.bzl",
    "ebook_pdf",
    "markdown_lib",
    "pandoc_chunked_html",
)

package(default_visibility = ["//visibility:public"])

markdown_lib(
    name = "md",
    srcs = [
        "//:README.md",
        "spec.md",
    ],
    additional_inputs = ["head.html"],
)

ebook_pdf(
    name = "book_pdf",
    deps = [":md"],
    metadata_xml = "epub-metadata.xml",
    title_yaml = "title.yaml",
)

pandoc_chunked_html(
    name = "html_chunked",
    deps = [":md"],
    toc = True,
    args = ["--include-in-header=ai/head.html"],
)
