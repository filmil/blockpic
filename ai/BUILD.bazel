load(
    "@bazel_ebook//build:rules.bzl",
    "ebook_pdf",
    "markdown_lib",
    "pandoc_chunked_html",
)
load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("//ai:diagram.bzl", "render_diagram")

package(default_visibility = ["//visibility:public"])

exports_files([
    "head.html",
    "shapes.svg",
    "pins_buses.svg",
    "dynamic_sizing.svg",
    "msi_blocks.svg",
    "pin_aware.svg",
    "complex_layout.svg",
    "text_rendering.svg",
    "arrow_rendering.svg",
])

markdown_lib(
    name = "md",
    srcs = [
        "datasheet.md",
        "spec.md",
    ] + glob(["tasks/*.md"]),
    additional_inputs = [
        "//ai:head.html",
        "shapes.svg",
        "pins_buses.svg",
        "dynamic_sizing.svg",
        "msi_blocks.svg",
        "pin_aware.svg",
        "complex_layout.svg",
        "text_rendering.svg",
        "arrow_rendering.svg",
    ],
)

ebook_pdf(
    name = "book_pdf",
    metadata_xml = "epub-metadata.xml",
    title_yaml = "title.yaml",
    deps = [":md"],
)

pandoc_chunked_html(
    name = "html_chunked",
    args = ["--include-in-header=ai/head.html"],
    toc = True,
    deps = [":md"],
)

render_diagram(
    name = "shapes",
    src = "examples/shapes.hodos",
)

render_diagram(
    name = "pins_buses",
    src = "examples/pins_buses.hodos",
)

render_diagram(
    name = "dynamic_sizing",
    src = "examples/dynamic_sizing.hodos",
)

render_diagram(
    name = "msi_blocks",
    src = "examples/msi_blocks.hodos",
)

render_diagram(
    name = "pin_aware",
    src = "examples/pin_aware.hodos",
)

write_source_files(
    name = "update_diagrams",
    files = {
        "shapes.svg": ":shapes",
        "pins_buses.svg": ":pins_buses",
        "dynamic_sizing.svg": ":dynamic_sizing",
        "msi_blocks.svg": ":msi_blocks",
        "pin_aware.svg": ":pin_aware",
        "complex_layout.svg": ":complex_layout",
        "text_rendering.svg": ":text_rendering",
        "arrow_rendering.svg": ":arrow_rendering",
    },
)

render_diagram(
    name = "complex_layout",
    src = "examples/complex_layout.hodos",
)

render_diagram(
    name = "text_rendering",
    src = "examples/text_rendering.hodos",
)

# Need to update write_source_files to include complex_layout

render_diagram(
    name = "arrow_rendering",
    src = "examples/arrow_rendering.hodos",
)
