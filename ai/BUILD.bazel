load(
    "@bazel_ebook//build:rules.bzl",
    "ebook_pdf",
    "markdown_lib",
    "pandoc_chunked_html",
)
load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")

package(default_visibility = ["//visibility:public"])

exports_files([
    "head.html",
    "shapes.png",
    "pins_buses.png",
    "dynamic_sizing.png",
    "msi_blocks.png",
])

markdown_lib(
    name = "md",
    srcs = [
        "datasheet.md",
        "spec.md",
    ] + glob(["tasks/*.md"]),
    additional_inputs = [
        "//ai:head.html",
        "shapes.png",
        "pins_buses.png",
        "dynamic_sizing.png",
        "msi_blocks.png",
    ],
)

ebook_pdf(
    name = "book_pdf",
    metadata_xml = "epub-metadata.xml",
    title_yaml = "title.yaml",
    deps = [":md"],
)

pandoc_chunked_html(
    name = "html_chunked",
    args = ["--include-in-header=ai/head.html"],
    toc = True,
    deps = [":md"],
)

genrule(
    name = "gen_shapes_example",
    srcs = ["examples/shapes.hodos"],
    outs = ["shapes_gen.png"],
    cmd = "$(location //cmd/hodos) render $(location examples/shapes.hodos) -o $@",
    tools = ["//cmd/hodos"],
)

genrule(
    name = "gen_pins_buses_example",
    srcs = ["examples/pins_buses.hodos"],
    outs = ["pins_buses_gen.png"],
    cmd = "$(location //cmd/hodos) render $(location examples/pins_buses.hodos) -o $@",
    tools = ["//cmd/hodos"],
)

genrule(
    name = "gen_dynamic_sizing_example",
    srcs = ["examples/dynamic_sizing.hodos"],
    outs = ["dynamic_sizing_gen.png"],
    cmd = "$(location //cmd/hodos) render $(location examples/dynamic_sizing.hodos) -o $@",
    tools = ["//cmd/hodos"],
)

genrule(
    name = "gen_msi_blocks_example",
    srcs = ["examples/msi_blocks.hodos"],
    outs = ["msi_blocks_gen.png"],
    cmd = "$(location //cmd/hodos) render $(location examples/msi_blocks.hodos) -o $@",
    tools = ["//cmd/hodos"],
)

write_source_files(
    name = "update_diagrams",
    files = {
        "shapes.png": ":gen_shapes_example",
        "pins_buses.png": ":gen_pins_buses_example",
        "dynamic_sizing.png": ":gen_dynamic_sizing_example",
        "msi_blocks.png": ":gen_msi_blocks_example",
    },
)
