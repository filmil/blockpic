load(
    "@bazel_ebook//build:rules.bzl",
    "ebook_pdf",
    "markdown_lib",
    "pandoc_chunked_html",
)
load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("//ai:diagram.bzl", "render_diagram")

package(default_visibility = ["//visibility:public"])

exports_files([
    "head.html",
    "shapes.png",
    "pins_buses.png",
    "dynamic_sizing.png",
    "msi_blocks.png",
    "pin_aware.png",
    "complex_layout.png",
])

markdown_lib(
    name = "md",
    srcs = [
        "datasheet.md",
        "spec.md",
    ] + glob(["tasks/*.md"]),
    additional_inputs = [
        "//ai:head.html",
        "shapes.png",
        "pins_buses.png",
        "dynamic_sizing.png",
        "msi_blocks.png",
        "pin_aware.png",
        "complex_layout.png",
    ],
)

ebook_pdf(
    name = "book_pdf",
    metadata_xml = "epub-metadata.xml",
    title_yaml = "title.yaml",
    deps = [":md"],
)

pandoc_chunked_html(
    name = "html_chunked",
    args = ["--include-in-header=ai/head.html"],
    toc = True,
    deps = [":md"],
)

render_diagram(
    name = "shapes",
    src = "examples/shapes.hodos",
)

render_diagram(
    name = "pins_buses",
    src = "examples/pins_buses.hodos",
)

render_diagram(
    name = "dynamic_sizing",
    src = "examples/dynamic_sizing.hodos",
)

render_diagram(
    name = "msi_blocks",
    src = "examples/msi_blocks.hodos",
)

render_diagram(
    name = "pin_aware",
    src = "examples/pin_aware.hodos",
)

write_source_files(
    name = "update_diagrams",
    files = {
        "shapes.png": ":gen_shapes_example",
        "pins_buses.png": ":gen_pins_buses_example",
        "dynamic_sizing.png": ":gen_dynamic_sizing_example",
        "msi_blocks.png": ":gen_msi_blocks_example",
        "pin_aware.png": ":gen_pin_aware_example",
        "complex_layout.png": ":gen_complex_layout_example",
        "text_rendering.png": ":gen_text_rendering_example",
        "arrow_rendering.png": ":gen_arrow_rendering_example",
    },
)

render_diagram(
    name = "complex_layout",
    src = "examples/complex_layout.hodos",
)

render_diagram(
    name = "text_rendering",
    src = "examples/text_rendering.hodos",
)

# Need to update write_source_files to include complex_layout

render_diagram(
    name = "arrow_rendering",
    src = "examples/arrow_rendering.hodos",
)
