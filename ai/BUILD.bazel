load(
    "@bazel_ebook//build:rules.bzl",
    "ebook_pdf",
    "markdown_lib",
    "pandoc_chunked_html",
)

package(default_visibility = ["//visibility:public"])

markdown_lib(
    name = "md",
    srcs = [
        "spec.md",
        "datasheet.md",
    ] + glob(["tasks/*.md"]),
    additional_inputs = ["head.html", ":shapes.png"],
)

ebook_pdf(
    name = "book_pdf",
    metadata_xml = "epub-metadata.xml",
    title_yaml = "title.yaml",
    deps = [":md"],
)

pandoc_chunked_html(
    name = "html_chunked",
    args = ["--include-in-header=ai/head.html"],
    toc = True,
    deps = [":md"],
)

genrule(
    name = "gen_shapes_example",
    srcs = ["examples/shapes.hodos"],
    outs = ["shapes.png"],
    cmd = "$(location //cmd/hodos) render $(location examples/shapes.hodos) -o $@",
    tools = ["//cmd/hodos"],
)
